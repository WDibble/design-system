{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist-lib"
  },
  "include": [
    "src/index.ts",
    "src/components/ui/**/*",
    "src/components/icons/**/*",
    "src/tokens/**/*",
    "src/lib/**/*",
    "src/hooks/**/*"
  ]
}
