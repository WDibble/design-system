{
  "name": "design-system",
  "private": true,
  "version": "0.1.0",
  "description": "A human-centric, agent-native design system built with React 19, Base UI, Tailwind CSS v4, and Motion.",
  "license": "MIT",
  "author": "WDibble",
  "repository": {
    "type": "git",
    "url": "https://github.com/WDibble/design-system.git"
  },
  "keywords": [
    "design-system",
    "react-19",
    "base-ui",
    "tailwindcss-v4",
    "motion",
    "ui-kit",
    "accessible",
    "oklch"
  ],
  "type": "module",
  "main": "./dist-lib/index.js",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./styles.css": "./src/index.css"
  },
  "files": [
    "dist-lib",
    "src",
    "public"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:app": "tsc -b && vite build",
    "build:lib": "vite build --config vite.config.lib.ts && tsc -p tsconfig.lib.json",
    "preview": "vite preview",
    "lint": "oxlint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "spellcheck": "cspell \"{src,skills}/**/*.{ts,tsx,md}\"",
    "invariants": "node scripts/verify-invariants.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run invariants && npm run lint && npm run test && npm run build",
    "prepare": "simple-git-hooks"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "simple-git-hooks": {
    "pre-commit": "npx nano-staged"
  },
  "nano-staged": {
    "*.{ts,tsx}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ],
    "*": [
      "node scripts/verify-invariants.mjs"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cspell/dict-en-gb": "^5.0.38",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "apca-w3": "^0.1.9",
    "axe-core": "^4.14.0",
    "cspell": "^9.8.0",
    "culori": "^4.0.2",
    "glob": "^14.0.3",
    "jsdom": "^29.1.1",
    "nano-staged": "^1.0.2",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^8.3.5",
    "vite-plugin-oxlint": "^2.2.1",
    "vitest": "^5.0.5",
    "vitest-axe": "^0.1.0"
  }
}
